<Window x:Class="WinKit.Todo.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史记录"
        Width="320"
        Height="420"
        MinWidth="260"
        MinHeight="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 微妙淡出淡入动画 -->
        <Style TargetType="Button" x:Key="IconButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="4,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#000"/>
                    <Setter Property="Background" Value="#20000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- 窗口主容器 -->
    <Border x:Name="RootBorder"
            Background="#E6FFFFFF"
            CornerRadius="12"
            BorderBrush="#33000000"
            BorderThickness="1">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. 标题栏 -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📜 待办历史记录" FontSize="14" FontWeight="Bold" Foreground="#333"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="CloseBtn" Content="✕" Style="{StaticResource IconButton}" Click="CloseBtn_Click" ToolTip="关闭"/>
                </StackPanel>
            </Grid>

            <!-- 2. 工具栏 -->
            <Grid Grid.Row="1" Margin="0,8,0,8">
                <TextBlock x:Name="CountText" Text="0 条记录" FontSize="11" Foreground="#777" VerticalAlignment="Center"/>
                <Button x:Name="ClearAllBtn" Content="清空历史" HorizontalAlignment="Right" Style="{StaticResource IconButton}" FontSize="11" Foreground="#D9534F" Click="ClearAllBtn_Click"/>
            </Grid>

            <!-- 3. 内容列表区 -->
            <Grid Grid.Row="2">
                <!-- 空白占位 -->
                <TextBlock x:Name="EmptyPlaceholder"
                           Text="暂无历史记录"
                           FontSize="12"
                           Foreground="#999"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>

                <!-- 历史列表 -->
                <ListBox x:Name="HistoryList"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#A0FFFFFF" CornerRadius="8" BorderBrush="#1F000000" BorderThickness="1" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FormattedTime}" FontSize="10" Foreground="#888" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#222" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <Button Content="↩ 恢复" Style="{StaticResource IconButton}" FontSize="11" Foreground="#28A745" Tag="{Binding}" Click="RestoreBtn_Click" ToolTip="恢复到待办列表" Margin="0,0,4,0"/>
                                        <Button Content="🗑" Style="{StaticResource IconButton}" FontSize="11" Foreground="#DC3545" Tag="{Binding}" Click="DeleteBtn_Click" ToolTip="彻底删除"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Border>
</Window>
