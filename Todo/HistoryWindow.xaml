<Window x:Class="WinKit.Todo.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办历史"
        Width="320"
        Height="440"
        MinWidth="240"
        MinHeight="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen">

    <!-- 窗口主容器 -->
    <Border Style="{StaticResource FluentWindowBorder}"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <!-- 1. 标题栏 -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent">
                <TextBlock Text="待办历史"
                           VerticalAlignment="Center"
                           Margin="16,0"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           Foreground="#222"/>

                <Button x:Name="CloseBtn"
                        Content="✕"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        Width="26" Height="26"
                        Style="{StaticResource TitleBarBtn}"
                        Opacity="1"
                        Click="CloseBtn_Click"
                        ToolTip="关闭"/>
            </Grid>

            <!-- 2. 统计与提示栏 -->
            <Grid Grid.Row="1" Margin="16,2,16,6">
                <TextBlock x:Name="CountText" Text="0 条记录" FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
            </Grid>

            <!-- 3. 内容列表区 -->
            <Grid Grid.Row="2" Margin="16,0,16,0">
                <!-- 空白占位 -->
                <TextBlock x:Name="EmptyPlaceholder"
                           Text="暂无已删除的待办历史"
                           FontSize="12"
                           Foreground="#88000000"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>

                <!-- 历史列表 -->
                <ListBox x:Name="HistoryList"
                         Background="Transparent"
                         BorderThickness="0"
                         Style="{StaticResource {x:Type ListBox}}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#99FFFFFF"
                                    BorderBrush="#15000000"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 待办标题 + 删除时间 -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="12.5"
                                                   Foreground="#222"
                                                   TextWrapping="Wrap"
                                                   LineHeight="16"
                                                   LineStackingStrategy="BlockLineHeight"
                                                   MaxHeight="50"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FormattedTime}"
                                                   FontSize="10"
                                                   Foreground="#888"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- 还原按钮（图标化 + ToolTip） -->
                                    <Button Grid.Column="1"
                                            Content="⟲"
                                            Style="{StaticResource ActionBtn}"
                                            Width="22" Height="22"
                                            FontSize="13"
                                            VerticalAlignment="Center"
                                            Margin="0,0,4,0"
                                            Tag="{Binding}"
                                            Click="RestoreBtn_Click"
                                            ToolTip="还原至待办列表"/>

                                    <!-- 彻底删除按钮 -->
                                    <Button Grid.Column="2"
                                            Content="✕"
                                            Style="{StaticResource ActionBtn}"
                                            Width="22" Height="22"
                                            FontSize="11"
                                            VerticalAlignment="Center"
                                            Tag="{Binding}"
                                            Click="DeleteBtn_Click"
                                            ToolTip="彻底删除"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- 4. 底部栏：清空历史 -->
            <Border Grid.Row="3" BorderBrush="#15000000" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <Button x:Name="ClearAllBtn"
                            Content="清空历史"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="80"
                            Style="{StaticResource FluentSecondaryButton}"
                            Click="ClearAllBtn_Click"/>
                </Grid>
            </Border>

            <!-- 右下角自定义 ResizeGrip 缩放手柄 -->
            <Grid Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Border x:Name="ResizeGripArea"
                        Width="12" Height="12"
                        Background="Transparent"
                        Cursor="SizeNWSE"
                        Opacity="0.4"
                        MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                        ToolTip="拖动调整大小">
                    <Canvas Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Line X1="10" Y1="4"  X2="4"  Y2="10" Stroke="#88888888" StrokeThickness="1.2" StrokeEndLineCap="Round"/>
                        <Line X1="10" Y1="7"  X2="7"  Y2="10" Stroke="#88888888" StrokeThickness="1.2" StrokeEndLineCap="Round"/>
                    </Canvas>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
