<Window x:Class="WinKit.Clipboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinKit.Clipboard.Models"
        Title="Clipboard" Width="300" Height="420"
        MinWidth="260" MinHeight="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize">

    <!-- 主容器：圆角边框 + 动态主题磨砂背景 -->
    <Border x:Name="RootBorder"
            Style="{StaticResource FluentWindowBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <!-- 窗口置顶顶部微光指示线 (置顶时显示，自适应避让圆角) -->
            <Border x:Name="TopAccentLine"
                    Grid.Row="0"
                    Height="1.5"
                    VerticalAlignment="Top"
                    Margin="16,0,16,0"
                    CornerRadius="1"
                    Background="{DynamicResource ThemeTopmostAccentLineBrush}"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"/>

            <!-- ══════════════════════════════════════════
                 1. 标题栏：拖动 + 固定/关闭按钮
            ══════════════════════════════════════════ -->
            <Grid Grid.Row="0" x:Name="TitleBar"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  MouseEnter="TitleBar_MouseEnter"
                  MouseLeave="TitleBar_MouseLeave"
                  Background="Transparent">

                <TextBlock Text="剪贴板"
                           VerticalAlignment="Center"
                           Margin="16,0"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,8,0">
                    <Button x:Name="PinBtn"
                            Content="📌"
                            Style="{StaticResource TitleBarBtn}"
                            Width="26" Height="26"
                            Opacity="0"
                            Click="PinBtn_Click"/>

                    <Button x:Name="CloseBtn"
                            Content="✕"
                            Style="{StaticResource TitleBarBtn}"
                            Width="26" Height="26"
                            Opacity="0"
                            Click="CloseBtn_Click"/>
                </StackPanel>
            </Grid>

            <!-- ══════════════════════════════════════════
                 2. 内容列表 (文本 + 54px 本地缩略图)
            ══════════════════════════════════════════ -->
            <Grid Grid.Row="1">
                <ListBox x:Name="ClipboardList"
                         Background="Transparent"
                         BorderThickness="0"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True"
                         FocusVisualStyle="{x:Null}"
                         IsTabStop="False"
                         KeyDown="ClipboardList_KeyDown">

                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer Style="{StaticResource NarrowScrollViewer}"
                                          Focusable="False">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListBoxItem_PreviewMouseLeftButtonDown"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="itemBd"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Margin="6,2">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="itemBd" Property="Background" Value="{DynamicResource ThemeItemHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="itemBd" Property="Background" Value="{DynamicResource ThemeItemSelectedBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ClipboardItem}">
                            <Grid Margin="8,6" MinHeight="26">
                                <!-- 1. 底层：内容展示区（文本或图片，占满 100% 宽度） -->
                                <Grid VerticalAlignment="Center">
                                    <!-- 文本类型模板 -->
                                    <TextBlock Text="{Binding DisplayText}"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap"
                                               MaxHeight="36"
                                               LineHeight="17"
                                               LineStackingStrategy="BlockLineHeight"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- 图片类型模板 (54px 等比缩略图 + 描述) -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Border CornerRadius="4" ClipToBounds="True" Background="#15000000" Margin="0,0,8,0">
                                            <Image Source="{Binding ThumbnailPath}"
                                                   Height="54"
                                                   MaxWidth="140"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayText}"
                                                       FontSize="11.5"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding FormattedTime}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource ThemeTextTertiaryBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- 2. 顶层：右侧重叠透明悬浮按钮层 (悬停时平滑浮现) -->
                                <StackPanel x:Name="OverlayActions"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Panel.ZIndex="10"
                                            Opacity="0"
                                            Margin="0,0,2,0">
                                    <!-- 仅对图片显示的“小眼睛”系统预览按钮 -->
                                    <Button x:Name="PreviewBtn"
                                            Content="👁"
                                            Width="22" Height="22"
                                            FontSize="12"
                                            Margin="1,0"
                                            Tag="{Binding}"
                                            Click="PreviewButton_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- 删除单项按钮 -->
                                    <Button x:Name="DeleteBtn"
                                            Content="✕"
                                            Style="{StaticResource ActionBtn}"
                                            Width="22" Height="22"
                                            FontSize="11"
                                            Margin="1,0"
                                            Tag="{Binding}"
                                            Click="DeleteButton_Click"/>
                                </StackPanel>
                            </Grid>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="OverlayActions" Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空列表提示 -->
                <TextBlock x:Name="EmptyPlaceholder"
                           Text="剪贴板历史为空"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource ThemeTextPlaceholderBrush}"
                           FontSize="13"
                           Visibility="Collapsed"
                           IsHitTestVisible="False"/>
            </Grid>

            <!-- ══════════════════════════════════════════
                 3. 底部状态栏 & 清空按钮
            ══════════════════════════════════════════ -->
            <Grid Grid.Row="2" Margin="10,0,10,0">
                <Button x:Name="ClearAllBtn"
                        Content="清空全部"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Width="80"
                        Height="26"
                        Style="{StaticResource FluentSecondaryButton}"
                        Click="ClearAllButton_Click"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="CountText" Text="0 项" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- 右下角自定义 ResizeGrip -->
            <Grid Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,0">
                <Border x:Name="ResizeGripArea"
                        Width="12" Height="12"
                        Background="Transparent"
                        Cursor="SizeNWSE"
                        Opacity="0.4"
                        MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown">
                    <Canvas Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Line X1="10" Y1="4"  X2="4"  Y2="10" Stroke="{DynamicResource ThemeTextTertiaryBrush}" StrokeThickness="1.2" StrokeEndLineCap="Round"/>
                        <Line X1="10" Y1="7"  X2="7"  Y2="10" Stroke="{DynamicResource ThemeTextTertiaryBrush}" StrokeThickness="1.2" StrokeEndLineCap="Round"/>
                    </Canvas>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
