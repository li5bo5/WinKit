<Window x:Class="WinKit.Clipboard.QuickPhraseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinKit.Clipboard.Models"
        Title="Quick Phrases" Width="300" MaxHeight="380"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- 主容器：圆角边框 + 动态主题磨砂背景 -->
    <Border x:Name="RootBorder"
            Style="{StaticResource FluentWindowBorder}">
        <Grid Margin="0,4,0,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏：简洁标题 + 关闭 -->
            <Grid Grid.Row="0" Margin="14,4,10,4">
                <TextBlock Text="常用短语"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="上下键选择 · Enter 回填"
                           FontSize="10"
                           Foreground="{DynamicResource ThemeTextTertiaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"/>
            </Grid>

            <!-- 格式损坏警告栏 (条件显示) -->
            <Border x:Name="WarningBar" Grid.Row="1"
                    Background="#FFFDE7" BorderBrush="#FFF59D" BorderThickness="1"
                    CornerRadius="4" Margin="10,2,10,4" Padding="6,4"
                    Visibility="Collapsed">
                <TextBlock Text="⚠️ 常用短语文件格式有误，当前显示上一次成功加载的内容"
                           FontSize="10.5" Foreground="#F57F17"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- 短语列表 -->
            <ListBox x:Name="PhrasesList" Grid.Row="2"
                     Background="Transparent"
                     BorderThickness="0"
                     MaxHeight="320"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     FocusVisualStyle="{x:Null}"
                     IsTabStop="False">

                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Style="{StaticResource NarrowScrollViewer}"
                                      Focusable="False">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListBoxItem_PreviewMouseLeftButtonDown"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="itemBd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Margin="6,1.5">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="itemBd" Property="Background" Value="{DynamicResource ThemeItemHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="itemBd" Property="Background" Value="{DynamicResource ThemeItemSelectedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:QuickPhraseItem}">
                        <Grid Margin="10,6">
                            <TextBlock Text="{Binding DisplayText}"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</Window>
