<Application x:Class="WinKit.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>

        <!-- ══════════════════════════════════════════════
             全局圆角半径常量
        ══════════════════════════════════════════════ -->
        <CornerRadius x:Key="Radius6">6</CornerRadius>
        <CornerRadius x:Key="Radius4">4</CornerRadius>
        <CornerRadius x:Key="Radius3">3</CornerRadius>

        <!-- ══════════════════════════════════════════════
             默认主题画刷（动态资源兜底定义，运行时由 ThemeManager 动态覆写）
        ══════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="ThemeWindowBackgroundBrush" Color="#E6F5F5F5"/>
        <SolidColorBrush x:Key="ThemeWindowBorderBrush" Color="#1A000000"/>
        <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="#222222"/>
        <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="#666666"/>
        <SolidColorBrush x:Key="ThemeTextTertiaryBrush" Color="#999999"/>
        <SolidColorBrush x:Key="ThemeTextPlaceholderBrush" Color="#88000000"/>
        <SolidColorBrush x:Key="ThemeItemHoverBrush" Color="#14000000"/>
        <SolidColorBrush x:Key="ThemeItemSelectedBrush" Color="#1F000000"/>
        <SolidColorBrush x:Key="ThemeInputBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeInputBorderBrush" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="ThemeCardBackgroundBrush" Color="#99FFFFFF"/>
        <SolidColorBrush x:Key="ThemeCardBorderBrush" Color="#15000000"/>
        <SolidColorBrush x:Key="ThemeSeparatorBrush" Color="#18000000"/>
        <SolidColorBrush x:Key="ThemeButtonHoverBrush" Color="#14000000"/>
        <SolidColorBrush x:Key="ThemeButtonPressedBrush" Color="#24000000"/>
        <SolidColorBrush x:Key="ThemeScrollBarThumbBrush" Color="#4D000000"/>

        <!-- ══════════════════════════════════════════════
             轻量半透明按钮体系画刷（动态资源兜底）
        ══════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="ThemeGlassButtonBackgroundBrush" Color="#0D000000"/>
        <SolidColorBrush x:Key="ThemeGlassButtonBorderBrush" Color="#1A000000"/>
        <SolidColorBrush x:Key="ThemeGlassButtonForegroundBrush" Color="#333333"/>
        <SolidColorBrush x:Key="ThemeGlassButtonHoverBackgroundBrush" Color="#1A000000"/>
        <SolidColorBrush x:Key="ThemeGlassButtonHoverBorderBrush" Color="#33000000"/>
        <SolidColorBrush x:Key="ThemeGlassButtonHoverForegroundBrush" Color="#111111"/>
        <SolidColorBrush x:Key="ThemeGlassDangerHoverBackgroundBrush" Color="#1AF44336"/>
        <SolidColorBrush x:Key="ThemeGlassDangerHoverBorderBrush" Color="#4DF44336"/>
        <SolidColorBrush x:Key="ThemeGlassDangerHoverForegroundBrush" Color="#D32F2F"/>

        <!-- 悬浮操作胶囊底板画刷（文字遮蔽增强） -->
        <SolidColorBrush x:Key="ThemeActionCapsuleBackgroundBrush" Color="#EEF5F5F7"/>
        <SolidColorBrush x:Key="ThemeActionCapsuleBorderBrush" Color="#22000000"/>

        <!-- 窗口置顶状态顶部微光指示线画刷 -->
        <SolidColorBrush x:Key="ThemeTopmostAccentLineBrush" Color="#2A75D3"/>

        <!-- ══════════════════════════════════════════════
             统一矢量图标 Geometry 数据
        ══════════════════════════════════════════════ -->
        <!-- 关闭 / 退出 ✕ -->
        <StreamGeometry x:Key="GeoClose">M 2,2 L 10,10 M 10,2 L 2,10</StreamGeometry>
        <!-- 固定 / 置顶未激活 📌 -->
        <StreamGeometry x:Key="GeoPin">M 6,1 L 9,4 L 7,6 L 8,9 L 6,8 L 4,11 L 3,9 L 1,6 L 4,5 Z</StreamGeometry>
        <!-- 固定 / 置顶激活 📍 -->
        <StreamGeometry x:Key="GeoPinned">M 6,1 C 4.5,1 3,2.5 3,4 C 3,6.5 6,11 6,11 C 6,11 9,6.5 9,4 C 9,2.5 7.5,1 6,1 Z M 6,5 C 5.4,5 5,4.6 5,4 C 5,3.4 5.4,3 6,3 C 6.6,3 7,3.4 7,4 C 7,4.6 6.6,5 6,5 Z</StreamGeometry>
        <!-- 穿透 ⊙ -->
        <StreamGeometry x:Key="GeoPassThrough">M 6,1 A 5,5 0 1 0 6,11 A 5,5 0 1 0 6,1 Z M 6,4 A 2,2 0 1 1 6,8 A 2,2 0 1 1 6,4 Z</StreamGeometry>
        <!-- 预览 / 小眼睛 👁️ -->
        <StreamGeometry x:Key="GeoEye">M 1,6 C 2.5,2.5 9.5,2.5 11,6 C 9.5,9.5 2.5,9.5 1,6 Z M 6,8 A 2,2 0 1 0 6,4 A 2,2 0 1 0 6,8 Z</StreamGeometry>
        <!-- 删除 🗑️ -->
        <StreamGeometry x:Key="GeoDelete">M 3,3 L 9,3 M 4,3 L 4,10 C 4,10.5 4.5,11 5,11 L 7,11 C 7.5,11 8,10.5 8,10 L 8,3 M 5,1.5 L 7,1.5</StreamGeometry>
        <!-- 编辑 ✏️ -->
        <StreamGeometry x:Key="GeoEdit">M 8.5,1.5 L 10.5,3.5 L 4,10 L 1.5,10.5 L 2,8 Z</StreamGeometry>
        <!-- 恢复 / 撤回 ↩️ -->
        <StreamGeometry x:Key="GeoRestore">M 4,4 L 1.5,6.5 L 4,9 M 2,6.5 L 7.5,6.5 C 9,6.5 10.5,7.5 10.5,9</StreamGeometry>
        <!-- 清空 / 扫帚 🧹 -->
        <StreamGeometry x:Key="GeoClear">M 2,10 L 10,2 M 8,1 L 11,4 M 1,11 L 3,11</StreamGeometry>

        <!-- ══════════════════════════════════════════════
             统一轻量半透明毛玻璃按钮 (WinKitGlassIconButton)
        ══════════════════════════════════════════════ -->
        <Style x:Key="WinKitGlassIconButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeGlassButtonForegroundBrush}"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius4}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeGlassButtonHoverBackgroundBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeGlassButtonHoverBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeGlassButtonHoverForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════
             统一轻量半透明危险按钮 (WinKitGlassDangerIconButton)
        ══════════════════════════════════════════════ -->
        <Style x:Key="WinKitGlassDangerIconButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeGlassButtonForegroundBrush}"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius4}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeGlassDangerHoverBackgroundBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeGlassDangerHoverBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeGlassDangerHoverForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════
             悬浮操作按钮胶囊底板样式 (ActionCapsuleBorder)
        ══════════════════════════════════════════════ -->
        <Style x:Key="ActionCapsuleBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeActionCapsuleBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeActionCapsuleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius4}"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <!-- ══════════════════════════════════════════════
             统一轻量半透明切换按钮 (WinKitGlassToggleButton)
        ══════════════════════════════════════════════ -->
        <Style x:Key="WinKitGlassToggleButton" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="{DynamicResource ThemeGlassButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeGlassButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeGlassButtonForegroundBrush}"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius4}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeGlassButtonHoverBackgroundBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeGlassButtonHoverBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeGlassButtonHoverForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeItemSelectedBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeGlassButtonHoverBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════
             待办事项文本样式（支持折叠/展开显示动态切换）
        ══════════════════════════════════════════════ -->
        <Style x:Key="TodoItemTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="MaxHeight" Value="54"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ══════════════════════════════════════════════
             细滚动条样式（4px宽，圆角滑块，自动隐藏）
        ══════════════════════════════════════════════ -->
        <Style x:Key="NarrowScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource ThemeScrollBarThumbBrush}"
                                CornerRadius="{StaticResource Radius3}"
                                Margin="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NarrowScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand"
                                                  Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand"
                                                  Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource NarrowScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NarrowScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Grid.Column="0"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    Margin="{TemplateBinding Padding}"/>

                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource NarrowScrollBar}"
                                       Orientation="Vertical"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Opacity="0"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="PART_VerticalScrollBar"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="PART_VerticalScrollBar"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0" BeginTime="0:0:0.8" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <EventTrigger RoutedEvent="ScrollViewer.ScrollChanged">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="PART_VerticalScrollBar"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1" Duration="0:0:0.1"/>
                                        <DoubleAnimation
                                            Storyboard.TargetName="PART_VerticalScrollBar"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0" BeginTime="0:0:1.5" Duration="0:0:0.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════
             WPF ContextMenu / MenuItem 现代 Fluent 隐式样式
        ══════════════════════════════════════════════ -->
        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="{DynamicResource ThemeWindowBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeWindowBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Opacity="0.15" Color="Black"/>
                            </Border.Effect>
                            <ItemsPresenter KeyboardNavigation.TabNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="templateRoot"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="4"
                                SnapsToDevicePixels="True"
                                Margin="2,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" SharedSizeGroup="MenuItemIconColumnGroup"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup"/>
                                    <ColumnDefinition Width="14"/>
                                </Grid.ColumnDefinitions>
                                
                                <ContentPresenter x:Name="Icon" 
                                                  ContentSource="Icon"
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center" 
                                                  Width="14" Height="14" 
                                                  Margin="4,0"/>
                                <Path x:Name="GlyphPanel" 
                                      Data="M 1,5 L 4,8 L 9,2" 
                                      Stroke="{DynamicResource ThemeTextPrimaryBrush}" 
                                      StrokeThickness="1.5" 
                                      FlowDirection="LeftToRight"
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center" 
                                      Visibility="Collapsed"/>

                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  Margin="6,4,12,4"
                                                  RecognizesAccessKey="True"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                  VerticalAlignment="Center"/>
                                
                                <Path x:Name="RightArrow" 
                                      Grid.Column="3" 
                                      Data="M 0,0 L 4,4 L 0,8" 
                                      Stroke="{DynamicResource ThemeTextSecondaryBrush}" 
                                      StrokeThickness="1" 
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center" 
                                      Visibility="Collapsed"/>

                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Right"
                                       PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}">
                                    <Border x:Name="SubMenuBorder"
                                            Background="{DynamicResource ThemeWindowBackgroundBrush}"
                                            BorderBrush="{DynamicResource ThemeWindowBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="2,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Opacity="0.15" Color="Black"/>
                                        </Border.Effect>
                                        <ScrollViewer x:Name="SubMenuScrollViewer" Style="{StaticResource NarrowScrollViewer}">
                                            <Grid RenderOptions.ClearTypeHint="Enabled">
                                                <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.TabNavigation="Cycle"/>
                                            </Grid>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="GlyphPanel" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource ThemeItemHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="RightArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════
             独立标题栏关闭按钮样式 (WinKitGlassCloseButton)
        ══════════════════════════════════════════════ -->
        <Style x:Key="WinKitGlassCloseButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius4}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeGlassDangerHoverBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeGlassDangerHoverForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════
             标题栏按钮（置顶/最小化/关闭）
        ══════════════════════════════════════════════ -->
        <Style x:Key="TitleBarBtn" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius4}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeButtonHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════
             操作按钮（编辑/删除）— 默认隐藏，列表行 hover 时显示
        ══════════════════════════════════════════════ -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius4}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeButtonHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════
             待办多行内联输入框（双击添加/编辑多行待办）
        ══════════════════════════════════════════════ -->
        <Style x:Key="InlineTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource Radius6}">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <!-- 自定义的水印文字 -->
                            <TextBlock x:Name="watermark" 
                                       Text="{TemplateBinding Tag}" 
                                       Foreground="{DynamicResource ThemeTextPlaceholderBrush}" 
                                       IsHitTestVisible="False"
                                       Margin="12,5"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value=""/>
                                    <Condition Property="Tag" Value="{x:Null}" SourceName="watermark"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="watermark" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#2A5CB8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════
             偏好设置中心快捷键/表单专属输入框（单行，固定26px高度）
        ══════════════════════════════════════════════ -->
        <Style x:Key="HotkeyInputBox" TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource Radius4}">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="watermark" 
                                       Text="{TemplateBinding Tag}" 
                                       Foreground="{DynamicResource ThemeTextPlaceholderBrush}" 
                                       IsHitTestVisible="False"
                                       Margin="8,0"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value=""/>
                                    <Condition Property="Tag" Value="{x:Null}" SourceName="watermark"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="watermark" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#2A5CB8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════
             统一设计系统：窗体外壳与卡片容器
        ══════════════════════════════════════════════ -->
        <Style x:Key="FluentWindowBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeWindowBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeWindowBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.18" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PreferencesCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- ══════════════════════════════════════════════
             统一设计系统：主按钮与次级线框按钮
        ══════════════════════════════════════════════ -->
        <Style x:Key="FluentPrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="#2A5CB8"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A6DC8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1F4AA0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentSecondaryButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="Transparent"
                                BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════
             统一设计系统：半透明圆角 ComboBox
        ══════════════════════════════════════════════ -->
        <Style x:Key="FluentComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0,22,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- 触发器外框与背景 -->
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="TemplateRoot"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{StaticResource Radius4}">
                                            <Grid>
                                                <!-- 右侧几何箭头 -->
                                                <Path x:Name="Arrow"
                                                      Data="M 0,0 L 4,4 L 8,0"
                                                      Stroke="{DynamicResource ThemeTextSecondaryBrush}"
                                                      StrokeThickness="1.5"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="#2A5CB8"/>
                                                <Setter TargetName="Arrow" Property="Data" Value="M 0,4 L 4,0 L 8,4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- 当前选中项文本呈现 -->
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"/>

                            <!-- 下拉弹出列表 -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="{DynamicResource ThemeWindowBackgroundBrush}"
                                        BorderBrush="{DynamicResource ThemeWindowBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"
                                        MaxHeight="200"
                                        Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.2" Color="Black"/>
                                    </Border.Effect>
                                    <ScrollViewer Style="{StaticResource NarrowScrollViewer}">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Margin="2,4"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBd"
                                Background="Transparent"
                                CornerRadius="4"
                                Margin="2,1">
                            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBd" Property="Background" Value="{DynamicResource ThemeItemHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBd" Property="Background" Value="{DynamicResource ThemeItemSelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════
             统一设计系统：精致微圆角 CheckBox
        ══════════════════════════════════════════════ -->
        <Style x:Key="FluentCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 复选小方块 -->
                            <Border x:Name="boxBd"
                                    Grid.Column="0"
                                    Width="18" Height="18"
                                    Background="{DynamicResource ThemeInputBackgroundBrush}"
                                    BorderBrush="{DynamicResource ThemeInputBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    VerticalAlignment="Center">
                                <Path x:Name="checkMark"
                                      Data="M 3,9 L 7,13 L 15,5"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                            </Border>

                            <!-- 标签文字 -->
                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="boxBd" Property="BorderBrush" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="boxBd" Property="Background" Value="#2A5CB8"/>
                                <Setter TargetName="boxBd" Property="BorderBrush" Value="#2A5CB8"/>
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="boxBd" Property="Background" Value="#3A6DC8"/>
                                <Setter TargetName="boxBd" Property="BorderBrush" Value="#3A6DC8"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
