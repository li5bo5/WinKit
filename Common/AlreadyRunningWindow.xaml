<Window x:Class="WinKit.Common.AlreadyRunningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinKit" Width="260" Height="150"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Style="{StaticResource FluentWindowBorder}"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid Margin="20,16,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 应用名 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                <TextBlock Text="WinKit" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
            </StackPanel>

            <!-- 提示信息 -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="程序已启动" 
                           FontSize="14.5" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="WinKit 正在系统后台常驻运行" 
                           FontSize="11.5" 
                           Foreground="{DynamicResource ThemeTextSecondaryBrush}" 
                           HorizontalAlignment="Center" 
                           Margin="0,5,0,0"/>
            </StackPanel>

            <!-- 底部提示 -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                <TextBlock Text="按 Esc 键或点击外部关闭" 
                           HorizontalAlignment="Center" 
                           FontSize="9.5" 
                           Foreground="{DynamicResource ThemeTextTertiaryBrush}" 
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
