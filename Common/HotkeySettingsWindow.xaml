<Window x:Class="WinKit.Common.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义快捷键" Width="300" Height="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="#D9F5F5F5"
            CornerRadius="10"
            BorderBrush="#1A000000"
            BorderThickness="1"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0">
                <TextBlock Text="自定义快捷键"
                           VerticalAlignment="Center"
                           Margin="18,0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#222"/>
                <Button Content="✕"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        Width="28" Height="28"
                        Style="{StaticResource TitleBarBtn}"
                        Opacity="1"
                        Click="CloseBtn_Click"/>
            </Grid>

            <!-- 快捷键列表 -->
            <ScrollViewer Grid.Row="1" Style="{StaticResource NarrowScrollViewer}" Margin="16,0">
                <StackPanel Margin="0,8,0,8">

                    <!-- 说明文字 -->
                    <TextBlock Text="点击输入框，直接按下目标按键组合即可完成设置。"
                               FontSize="11.5" Foreground="#777"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <!-- 行模板：标签 + 快捷键输入框 -->
                    <!-- 1. 置顶显示快捷键 -->
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="置顶显示" FontSize="12.5" Foreground="#222"/>
                            <TextBlock Text="默认：Ctrl + D" FontSize="10.5" Foreground="#999"/>
                        </StackPanel>
                        <TextBox x:Name="HkTodoTop" Grid.Column="1"
                                 Style="{StaticResource InlineTextBox}"
                                 IsReadOnly="True"
                                 GotFocus="HotkeyBox_GotFocus"
                                 LostFocus="HotkeyBox_LostFocus"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                 Tag="HotkeyTodoTopToggle"
                                 Cursor="Hand"
                                 ToolTip="点击此处，然后按下目标快捷键"/>
                    </Grid>

                    <Separator Margin="0,8" Background="#15000000"/>

                    <!-- 2. 唤出/隐藏剪贴板 -->
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="唤出剪贴板" FontSize="12.5" Foreground="#222"/>
                            <TextBlock Text="默认：Win + V" FontSize="10.5" Foreground="#999"/>
                        </StackPanel>
                        <TextBox x:Name="HkClipboard" Grid.Column="1"
                                 Style="{StaticResource InlineTextBox}"
                                 IsReadOnly="True"
                                 GotFocus="HotkeyBox_GotFocus"
                                 LostFocus="HotkeyBox_LostFocus"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                 Tag="HotkeyClipboardToggle"
                                 Cursor="Hand"
                                 ToolTip="点击此处，然后按下目标快捷键"/>
                    </Grid>

                    <Separator Margin="0,8" Background="#15000000"/>

                    <!-- 5. 保存并退出编辑 -->
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="保存并退出编辑" FontSize="12.5" Foreground="#222"/>
                            <TextBlock Text="默认：Ctrl + S" FontSize="10.5" Foreground="#999"/>
                        </StackPanel>
                        <TextBox x:Name="HkSaveExit" Grid.Column="1"
                                 Style="{StaticResource InlineTextBox}"
                                 IsReadOnly="True"
                                 GotFocus="HotkeyBox_GotFocus"
                                 LostFocus="HotkeyBox_LostFocus"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                 Tag="HotkeyTodoSaveAndExit"
                                 Cursor="Hand"
                                 ToolTip="点击此处，然后按下目标快捷键"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮栏 -->
            <Border Grid.Row="2" BorderBrush="#12000000" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,16,0" >

                    <Button Content="恢复默认"
                            Width="72" Height="28"
                            Margin="0,0,10,0"
                            FontSize="12"
                            Cursor="Hand"
                            Click="ResetBtn_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="#44000000"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="#555"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#12000000"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="保 存"
                            Width="72" Height="28"
                            FontSize="12"
                            Cursor="Hand"
                            Click="SaveBtn_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2A5CB8"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#3A6DC8"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#1F4AA0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
