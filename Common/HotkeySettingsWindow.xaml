<Window x:Class="WinKit.Common.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="偏好设置" Width="360" Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Style="{StaticResource FluentWindowBorder}"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" x:Name="TitleBar"
                  MouseEnter="TitleBar_MouseEnter"
                  MouseLeave="TitleBar_MouseLeave"
                  Background="Transparent">
                <TextBlock Text="偏好设置"
                           VerticalAlignment="Center"
                           Margin="16,0"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                <Button x:Name="CloseBtn"
                        Content="✕"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        Width="26" Height="26"
                        Opacity="0"
                        Style="{StaticResource TitleBarBtn}"
                        Click="CloseBtn_Click"/>
            </Grid>

            <!-- 设置内容滚动区 -->
            <ScrollViewer Grid.Row="1" Style="{StaticResource NarrowScrollViewer}" Margin="16,0,16,0">
                <StackPanel Margin="0,4,0,4">

                    <!-- 说明文字 -->
                    <TextBlock Text="点击快捷键输入框可直接按下目标物理按键进行录入。"
                               FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                               Margin="2,0,0,8"/>

                    <!-- ══════════════════════════════════════════
                         分组 1：待办清单 (TodoList)
                    ══════════════════════════════════════════ -->
                    <TextBlock Text="待办清单 (TodoList)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="2,0,0,6"/>
                    <Border Style="{StaticResource PreferencesCard}">
                        <StackPanel>
                            <!-- 置顶显示快捷键 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="置顶显示快捷键" FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    <TextBlock Text="默认：Ctrl + D" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                </StackPanel>
                                <TextBox x:Name="HkTodoTop" Grid.Column="1"
                                         Style="{StaticResource HotkeyInputBox}"
                                         IsReadOnly="True"
                                         GotFocus="HotkeyBox_GotFocus"
                                         LostFocus="HotkeyBox_LostFocus"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                         Tag="HotkeyTodoTopToggle"
                                         Cursor="Hand"/>
                            </Grid>

                            <Separator Margin="0,6" Background="{DynamicResource ThemeSeparatorBrush}"/>

                            <!-- 保存并退出编辑快捷键 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="保存退出编辑快捷键" FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    <TextBlock Text="默认：Ctrl + S" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                </StackPanel>
                                <TextBox x:Name="HkSaveExit" Grid.Column="1"
                                         Style="{StaticResource HotkeyInputBox}"
                                         IsReadOnly="True"
                                         GotFocus="HotkeyBox_GotFocus"
                                         LostFocus="HotkeyBox_LostFocus"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                         Tag="HotkeyTodoSaveAndExit"
                                         Cursor="Hand"/>
                            </Grid>

                            <Separator Margin="0,6" Background="{DynamicResource ThemeSeparatorBrush}"/>

                            <!-- 待办事项展开显示 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="待办内容展开显示" FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    <TextBlock Text="完整展开全部多行文本，自适应高度" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkTodoExpandedDisplay" Grid.Column="1"
                                          Style="{StaticResource FluentCheckBox}"/>
                            </Grid>

                            <Separator Margin="0,6" Background="{DynamicResource ThemeSeparatorBrush}"/>

                            <!-- 双击托盘唤出 TodoList -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="双击托盘唤出待办清单" FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    <TextBlock Text="双击托盘图标切换置顶显示或隐藏" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkTrayDoubleClick" Grid.Column="1"
                                          Style="{StaticResource FluentCheckBox}"/>
                            </Grid>

                            <Separator Margin="0,6" Background="{DynamicResource ThemeSeparatorBrush}"/>

                            <!-- 待办历史保留天数 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="历史记录保留天数" FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    <TextBlock Text="超时自动清理" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbRetentionDays" Grid.Column="1"
                                          Style="{StaticResource FluentComboBox}">
                                    <ComboBoxItem Content="30 天" Tag="30"/>
                                    <ComboBoxItem Content="60 天 (默认)" Tag="60"/>
                                    <ComboBoxItem Content="90 天" Tag="90"/>
                                    <ComboBoxItem Content="180 天" Tag="180"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ══════════════════════════════════════════
                         分组 2：常用短语 (Quick Phrases)
                    ══════════════════════════════════════════ -->
                    <TextBlock Text="常用短语 (Quick Phrases)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="2,6,0,6"/>
                    <Border Style="{StaticResource PreferencesCard}">
                        <StackPanel>
                            <!-- 启用 vv 触发常用短语 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="启用连续输入 vv 呼出短语" FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    <TextBlock Text="快速连按两次小写 v 键呼出常用短语选择框" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkQuickPhrase" Grid.Column="1"
                                          Style="{StaticResource FluentCheckBox}"/>
                            </Grid>

                            <Separator Margin="0,6" Background="{DynamicResource ThemeSeparatorBrush}"/>

                            <!-- 短语文件管理操作 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="短语库管理" FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    <TextBlock Text="自定义或恢复默认" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                </StackPanel>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnOpenPhrasesFile" Grid.Column="0"
                                            Content="编辑"
                                            Style="{StaticResource FluentSecondaryButton}"
                                            Height="26"
                                            Click="BtnOpenPhrasesFile_Click"/>
                                    <Button x:Name="BtnResetPhrases" Grid.Column="2"
                                            Content="重置"
                                            Style="{StaticResource FluentSecondaryButton}"
                                            Height="26"
                                            Click="BtnResetPhrases_Click"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ══════════════════════════════════════════
                         分组 3：剪贴板 (Clipboard)
                    ══════════════════════════════════════════ -->
                    <TextBlock Text="剪贴板 (Clipboard)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="2,6,0,6"/>
                    <Border Style="{StaticResource PreferencesCard}">
                        <StackPanel>
                            <!-- 唤出剪贴板快捷键 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="唤出剪贴板快捷键" FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    <TextBlock Text="默认：Win + V" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                </StackPanel>
                                <TextBox x:Name="HkClipboard" Grid.Column="1"
                                         Style="{StaticResource HotkeyInputBox}"
                                         IsReadOnly="True"
                                         GotFocus="HotkeyBox_GotFocus"
                                         LostFocus="HotkeyBox_LostFocus"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                         Tag="HotkeyClipboardToggle"
                                         Cursor="Hand"/>
                            </Grid>

                            <Separator Margin="0,6" Background="{DynamicResource ThemeSeparatorBrush}"/>

                            <!-- 启用剪贴板监控 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="启用剪贴板监听与记录" FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkPasteMonitoring" Grid.Column="1"
                                          Style="{StaticResource FluentCheckBox}"/>
                            </Grid>

                            <Separator Margin="0,6" Background="{DynamicResource ThemeSeparatorBrush}"/>

                            <!-- 启用历史文本去重 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="启用历史文本自动去重" FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkPasteDedup" Grid.Column="1"
                                          Style="{StaticResource FluentCheckBox}"/>
                            </Grid>

                            <Separator Margin="0,6" Background="{DynamicResource ThemeSeparatorBrush}"/>

                            <!-- 记忆列表滚动位置 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="记忆剪贴板列表滚动位置" FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkPasteRememberScroll" Grid.Column="1"
                                          Style="{StaticResource FluentCheckBox}"/>
                            </Grid>

                            <Separator Margin="0,6" Background="{DynamicResource ThemeSeparatorBrush}"/>

                            <!-- 剪贴板历史保留条数 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="文本记录保留条数" FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    <TextBlock Text="超限自动折半清理" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbPasteMaxItems" Grid.Column="1"
                                          Style="{StaticResource FluentComboBox}">
                                    <ComboBoxItem Content="100 条" Tag="100"/>
                                    <ComboBoxItem Content="200 条" Tag="200"/>
                                    <ComboBoxItem Content="300 条 (默认)" Tag="300"/>
                                    <ComboBoxItem Content="400 条" Tag="400"/>
                                    <ComboBoxItem Content="500 条" Tag="500"/>
                                </ComboBox>
                            </Grid>

                            <Separator Margin="0,6" Background="{DynamicResource ThemeSeparatorBrush}"/>

                            <!-- 图片历史保留天数 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="图片历史保留天数" FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    <TextBlock Text="过期自动清理" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbImageRetentionDays" Grid.Column="1"
                                          Style="{StaticResource FluentComboBox}">
                                    <ComboBoxItem Content="7 天" Tag="7"/>
                                    <ComboBoxItem Content="15 天 (默认)" Tag="15"/>
                                    <ComboBoxItem Content="30 天" Tag="30"/>
                                    <ComboBoxItem Content="60 天" Tag="60"/>
                                </ComboBox>
                            </Grid>

                            <Separator Margin="0,6" Background="{DynamicResource ThemeSeparatorBrush}"/>

                            <!-- 图片缓存空间上限 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="图片最大存储空间" FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    <TextBlock Text="超限自动折半清理" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbImageMaxStorage" Grid.Column="1"
                                          Style="{StaticResource FluentComboBox}">
                                    <ComboBoxItem Content="50 MB" Tag="50"/>
                                    <ComboBoxItem Content="100 MB (默认)" Tag="100"/>
                                    <ComboBoxItem Content="200 MB" Tag="200"/>
                                    <ComboBoxItem Content="500 MB" Tag="500"/>
                                    <ComboBoxItem Content="1024 MB (1GB)" Tag="1024"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ══════════════════════════════════════════
                         分组 4：常规与外观 (General)
                    ══════════════════════════════════════════ -->
                    <TextBlock Text="常规与外观 (General)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="2,6,0,6"/>
                    <Border Style="{StaticResource PreferencesCard}">
                        <StackPanel>
                            <!-- 颜色主题模式 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="颜色主题" FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    <TextBlock Text="跟随系统 / 浅色 / 深色" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbThemeMode" Grid.Column="1"
                                          Style="{StaticResource FluentComboBox}"
                                          SelectionChanged="CmbThemeMode_SelectionChanged">
                                    <ComboBoxItem Content="跟随系统 (默认)" Tag="System"/>
                                    <ComboBoxItem Content="浅色" Tag="Light"/>
                                    <ComboBoxItem Content="深色" Tag="Dark"/>
                                </ComboBox>
                            </Grid>

                            <Separator Margin="0,6" Background="{DynamicResource ThemeSeparatorBrush}"/>

                            <!-- 窗口不透明度 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="窗口不透明度" FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CmbOpacity" Grid.Column="1"
                                          Style="{StaticResource FluentComboBox}"
                                          SelectionChanged="CmbOpacity_SelectionChanged">
                                    <ComboBoxItem Content="40%" Tag="40"/>
                                    <ComboBoxItem Content="60%" Tag="60"/>
                                    <ComboBoxItem Content="70%" Tag="70"/>
                                    <ComboBoxItem Content="80%" Tag="80"/>
                                    <ComboBoxItem Content="90%" Tag="90"/>
                                    <ComboBoxItem Content="100% (默认)" Tag="100"/>
                                </ComboBox>
                            </Grid>

                            <Separator Margin="0,6" Background="{DynamicResource ThemeSeparatorBrush}"/>

                            <!-- 开机自动启动 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="开机时自动启动 WinKit" FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkAutoStart" Grid.Column="1"
                                          Style="{StaticResource FluentCheckBox}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- 底部操作按钮栏 -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,16,0">

                    <Button Content="恢复默认"
                            Width="80"
                            Height="26"
                            Margin="0,0,10,0"
                            Style="{StaticResource FluentSecondaryButton}"
                            Click="ResetBtn_Click"/>

                    <Button Content="保 存"
                            Width="80"
                            Height="26"
                            Style="{StaticResource FluentPrimaryButton}"
                            Click="SaveBtn_Click"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
