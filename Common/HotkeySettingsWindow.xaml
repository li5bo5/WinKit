<Window x:Class="WinKit.Common.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="偏好设置" Width="350" Height="530"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Style="{StaticResource FluentWindowBorder}"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0">
                <TextBlock Text="偏好设置"
                           VerticalAlignment="Center"
                           Margin="16,0"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           Foreground="#222"/>
                <Button Content="✕"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        Width="26" Height="26"
                        Style="{StaticResource TitleBarBtn}"
                        Opacity="1"
                        Click="CloseBtn_Click"/>
            </Grid>

            <!-- 设置内容滚动区 -->
            <ScrollViewer Grid.Row="1" Style="{StaticResource NarrowScrollViewer}" Margin="16,0,16,0">
                <StackPanel Margin="0,4,0,4">

                    <!-- 说明文字 -->
                    <TextBlock Text="点击快捷键输入框可直接按下目标物理按键进行录入。"
                               FontSize="11" Foreground="#888"
                               Margin="2,0,0,8"/>

                    <!-- ══════════════════════════════════════════
                         分组 1：待办清单 (TodoList)
                    ══════════════════════════════════════════ -->
                    <TextBlock Text="待办清单 (TodoList)" FontSize="12" FontWeight="SemiBold" Foreground="#444" Margin="2,0,0,6"/>
                    <Border Style="{StaticResource PreferencesCard}">
                        <StackPanel>
                            <!-- 置顶显示快捷键 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="置顶显示快捷键" FontSize="12" Foreground="#222"/>
                                    <TextBlock Text="默认：Ctrl + D" FontSize="10" Foreground="#999"/>
                                </StackPanel>
                                <TextBox x:Name="HkTodoTop" Grid.Column="1"
                                         Style="{StaticResource InlineTextBox}"
                                         IsReadOnly="True"
                                         GotFocus="HotkeyBox_GotFocus"
                                         LostFocus="HotkeyBox_LostFocus"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                         Tag="HotkeyTodoTopToggle"
                                         Cursor="Hand"
                                         ToolTip="点击此处，然后按下目标快捷键"/>
                            </Grid>

                            <Separator Margin="0,6" Background="#12000000"/>

                            <!-- 保存并退出编辑快捷键 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="保存退出编辑快捷键" FontSize="12" Foreground="#222"/>
                                    <TextBlock Text="默认：Ctrl + S" FontSize="10" Foreground="#999"/>
                                </StackPanel>
                                <TextBox x:Name="HkSaveExit" Grid.Column="1"
                                         Style="{StaticResource InlineTextBox}"
                                         IsReadOnly="True"
                                         GotFocus="HotkeyBox_GotFocus"
                                         LostFocus="HotkeyBox_LostFocus"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                         Tag="HotkeyTodoSaveAndExit"
                                         Cursor="Hand"
                                         ToolTip="点击此处，然后按下目标快捷键"/>
                            </Grid>

                            <Separator Margin="0,6" Background="#12000000"/>

                            <!-- 双击托盘唤出 TodoList -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="双击托盘唤出待办清单" FontSize="12" Foreground="#222"/>
                                    <TextBlock Text="双击托盘图标切换置顶显示或隐藏" FontSize="10" Foreground="#999"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkTrayDoubleClick" Grid.Column="1"
                                          Style="{StaticResource FluentCheckBox}"/>
                            </Grid>

                            <Separator Margin="0,6" Background="#12000000"/>

                            <!-- 待办历史保留天数 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="历史记录保留天数" FontSize="12" Foreground="#222"/>
                                    <TextBlock Text="超时自动清理" FontSize="10" Foreground="#999"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbRetentionDays" Grid.Column="1"
                                          Style="{StaticResource FluentComboBox}">
                                    <ComboBoxItem Content="30 天" Tag="30"/>
                                    <ComboBoxItem Content="60 天 (默认)" Tag="60"/>
                                    <ComboBoxItem Content="90 天" Tag="90"/>
                                    <ComboBoxItem Content="180 天" Tag="180"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ══════════════════════════════════════════
                         分组 2：剪贴板 (Clipboard)
                    ══════════════════════════════════════════ -->
                    <TextBlock Text="剪贴板 (Clipboard)" FontSize="12" FontWeight="SemiBold" Foreground="#444" Margin="2,2,0,6"/>
                    <Border Style="{StaticResource PreferencesCard}">
                        <StackPanel>
                            <!-- 唤出剪贴板快捷键 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="唤出剪贴板快捷键" FontSize="12" Foreground="#222"/>
                                    <TextBlock Text="默认：Win + V" FontSize="10" Foreground="#999"/>
                                </StackPanel>
                                <TextBox x:Name="HkClipboard" Grid.Column="1"
                                         Style="{StaticResource InlineTextBox}"
                                         IsReadOnly="True"
                                         GotFocus="HotkeyBox_GotFocus"
                                         LostFocus="HotkeyBox_LostFocus"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                         Tag="HotkeyClipboardToggle"
                                         Cursor="Hand"
                                         ToolTip="点击此处，然后按下目标快捷键"/>
                            </Grid>

                            <Separator Margin="0,6" Background="#12000000"/>

                            <!-- 启用剪贴板监控 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="启用剪贴板监听与记录" FontSize="12" Foreground="#222" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkPasteMonitoring" Grid.Column="1"
                                          Style="{StaticResource FluentCheckBox}"/>
                            </Grid>

                            <Separator Margin="0,6" Background="#12000000"/>

                            <!-- 启用历史文本去重 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="启用历史文本自动去重" FontSize="12" Foreground="#222" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkPasteDedup" Grid.Column="1"
                                          Style="{StaticResource FluentCheckBox}"/>
                            </Grid>

                            <Separator Margin="0,6" Background="#12000000"/>

                            <!-- 记忆列表滚动位置 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="记忆剪贴板列表滚动位置" FontSize="12" Foreground="#222" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkPasteRememberScroll" Grid.Column="1"
                                          Style="{StaticResource FluentCheckBox}"/>
                            </Grid>

                            <Separator Margin="0,6" Background="#12000000"/>

                            <!-- 剪贴板历史保留条数 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="历史记录保留条数" FontSize="12" Foreground="#222"/>
                                    <TextBlock Text="超限自动折半清理" FontSize="10" Foreground="#999"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbPasteMaxItems" Grid.Column="1"
                                          Style="{StaticResource FluentComboBox}">
                                    <ComboBoxItem Content="100 条" Tag="100"/>
                                    <ComboBoxItem Content="200 条" Tag="200"/>
                                    <ComboBoxItem Content="300 条 (默认)" Tag="300"/>
                                    <ComboBoxItem Content="400 条" Tag="400"/>
                                    <ComboBoxItem Content="500 条" Tag="500"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ══════════════════════════════════════════
                         分组 3：常规与外观 (General)
                    ══════════════════════════════════════════ -->
                    <TextBlock Text="常规与外观 (General)" FontSize="12" FontWeight="SemiBold" Foreground="#444" Margin="2,2,0,6"/>
                    <Border Style="{StaticResource PreferencesCard}">
                        <StackPanel>
                            <!-- 窗口不透明度 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="窗口不透明度" FontSize="12" Foreground="#222" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CmbOpacity" Grid.Column="1"
                                          Style="{StaticResource FluentComboBox}">
                                    <ComboBoxItem Content="40%" Tag="40"/>
                                    <ComboBoxItem Content="60%" Tag="60"/>
                                    <ComboBoxItem Content="70%" Tag="70"/>
                                    <ComboBoxItem Content="80%" Tag="80"/>
                                    <ComboBoxItem Content="90%" Tag="90"/>
                                    <ComboBoxItem Content="100% (默认)" Tag="100"/>
                                </ComboBox>
                            </Grid>

                            <Separator Margin="0,6" Background="#12000000"/>

                            <!-- 开机自动启动 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="开机时自动启动 WinKit" FontSize="12" Foreground="#222" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkAutoStart" Grid.Column="1"
                                          Style="{StaticResource FluentCheckBox}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- 底部操作按钮栏 -->
            <Border Grid.Row="2" BorderBrush="#15000000" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,16,0">

                    <Button Content="恢复默认"
                            Width="80"
                            Margin="0,0,10,0"
                            Style="{StaticResource FluentSecondaryButton}"
                            Click="ResetBtn_Click"/>

                    <Button Content="保 存"
                            Width="80"
                            Style="{StaticResource FluentPrimaryButton}"
                            Click="SaveBtn_Click"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
