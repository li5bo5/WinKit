<Window x:Class="WinKit.Common.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 WinKit" Width="280" Height="175"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Style="{StaticResource FluentWindowBorder}"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid Margin="20,18,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 应用名 & 版本 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Text="WinKit" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                <TextBlock x:Name="VersionText" Text="v2.4" FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="6,0,0,2" VerticalAlignment="Bottom"/>
            </StackPanel>

            <!-- 信息表格 -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="作者:" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="li5bo5" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="项目地址:" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="LinkText" 
                           Text="github.com/li5bo5/WinKit" 
                           Foreground="#2A75D3" 
                           FontSize="12" 
                           Cursor="Hand" 
                           TextDecorations="Underline"
                           MouseEnter="LinkText_MouseEnter"
                           MouseLeave="LinkText_MouseLeave"
                           MouseLeftButtonDown="LinkText_MouseLeftButtonDown"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="开源协议:" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="4" Grid.Column="2" Text="AGPL-3.0" ToolTip="GNU Affero General Public License v3.0" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
            </Grid>

            <!-- 底部：版权与提示 -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                <TextBlock Text="© 2026 li5bo5. All Rights Reserved." 
                           HorizontalAlignment="Center" 
                           FontSize="10" 
                           Foreground="{DynamicResource ThemeTextTertiaryBrush}"/>
                <TextBlock Text="按 Esc 键关闭" 
                           HorizontalAlignment="Center" 
                           FontSize="9" 
                           Foreground="{DynamicResource ThemeTextTertiaryBrush}" 
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
